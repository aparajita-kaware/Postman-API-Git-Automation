          "listen": "test",
          "script": {
            "exec": [
              "const tcId = pm.iterationData.get(\"testCaseId\");\r",
              "const expectedStatus = Number(pm.iterationData.get(\"expectedDeleteStatus\"));\r",
              "\r",
              "pm.test(`[${tcId}] Delete User status is ${expectedStatus} (No Content)`, function () {\r",
              "    pm.response.to.have.status(expectedStatus);\r",
              "    pm.expect(pm.response.text()).to.be.empty;\r",
              "});\r",
