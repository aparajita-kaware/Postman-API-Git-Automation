  "item": [
    {
      "name": "RegisterUser",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "// 1. Reset chained environment variables at the start of every CSV row\r",
              "pm.environment.unset(\"userId\");\r",
              "pm.environment.unset(\"authToken\");\r",
              "\r",
              "// 2. Dynamically build JSON body so blank CSV cells are omitted cleanly\r",
              "const email = pm.iterationData.get(\"email\");\r",
              "const password = pm.iterationData.get(\"password\");\r",
              "\r",
              "const payload = {};\r",
              "if (email !== undefined && email !== \"\") payload.email = email;\r",
              "if (password !== undefined && password !== \"\") payload.password = password;\r",
              "\r",
              "pm.environment.set(\"dynamicAuthPayload\", JSON.stringify(payload));"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "const tcId = pm.iterationData.get(\"testCaseId\") || \"N/A\";",
              "const desc = pm.iterationData.get(\"scenarioDescription\") || \"Manual Run\";",
              "const expectedStatus = Number(pm.iterationData.get(\"expectedRegisterStatus\")) || pm.response.code;",
              "const responseData = pm.response.json();",
              "",
              "pm.test(`[${tcId}] ${desc} - Status is ${expectedStatus}`, function () {",
              "    pm.response.to.have.status(expectedStatus);",
              "});",
              "",
              "// New tests for coverage",
              "pm.test(`[${tcId}] Response time is within acceptable limits`, function () {",
              "    pm.expect(pm.response.responseTime).to.be.below(2000);",
              "});",
              "",
              "pm.test(`[${tcId}] Content-Type is application/json`, function () {",
              "    pm.response.to.have.header(\"Content-Type\", \"application/json; charset=utf-8\");",
              "});",
              "",
              "if (pm.response.code === 200 && expectedStatus === 200) {",
              "    pm.test(`[${tcId}] Registration returns valid ID and Token`, function () {",
              "        pm.expect(responseData).to.have.property(\"id\");",
              "        pm.expect(responseData).to.have.property(\"token\").that.is.a(\"string\").and.not.empty;",
              "    });",
              "",
              "    // Save chained values into Environment for Requests 2-5",
              "    pm.environment.set(\"userId\", responseData.id);",
              "    pm.environment.set(\"authToken\", responseData.token);",
              "} else {",
              "    const expectedError = pm.iterationData.get(\"expectedErrorMsg\");",
              "    if (expectedError) {",
              "        pm.test(`[${tcId}] Error message matches '${expectedError}'`, function () {",
              "            pm.expect(responseData.error).to.eql(expectedError);",
              "        });",
              "    }",
              "",
              "    // Short-circuit Requests 2-5 for negative test cases (TC_03 - TC_09)",
              "    pm.execution.setNextRequest(null);",
              "}"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "x-api-key",
            "value": "{{apiKey}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{{dynamicAuthPayload}}\r\n",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseURL}}/register",
          "host": [
            "{{baseURL}}"
          ],
          "path": [
            "register"
          ]
        }
      },
      "response": []
    },
