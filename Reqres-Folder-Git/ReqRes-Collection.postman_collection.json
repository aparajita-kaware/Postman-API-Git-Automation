              "// Log target user ID being cleaned up for audit traceability in Postman Console\r",
              "const targetId = pm.environment.get(\"userId\");\r",
              "const tcId = pm.iterationData.get(\"testCaseId\");\r",
              "console.log(`[${tcId}] Executing cleanup DELETE for userId: ${targetId}`);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
