        "exec": [
          "// Reset chained environment/collection variables on the first request of each CSV row\r",
          "if (pm.info.requestName === \"1. Register User\") {\r",
          "    pm.collectionVariables.unset(\"userId\");\r",
          "    pm.collectionVariables.unset(\"authToken\");\r",
          "}\r",
          "\r",
          "// Dynamically build JSON payload so blank CSV cells are omitted (or sent cleanly)\r",
          "const email = pm.iterationData.get(\"email\");\r",
          "const password = pm.iterationData.get(\"password\");\r",
          "\r",
          "if (pm.info.requestName === \"1. Register User\" || pm.info.requestName === \"2. Login User\") {\r",
          "    const payload = {};\r",
          "    if (email !== undefined && email !== \"\") payload.email = email;\r",
          "    if (password !== undefined && password !== \"\") payload.password = password;\r",
