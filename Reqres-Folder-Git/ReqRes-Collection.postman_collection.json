      "name": "GetUserProfile",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "// Guard check: ensure userId and authToken were populated by prior steps\r",
              "if (!pm.environment.get(\"userId\") || !pm.environment.get(\"authToken\")) {\r",
              "    throw new Error(\"Missing chained 'userId' or 'authToken' in Environment.\");\r",
              "}"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "const tcId = pm.iterationData.get(\"testCaseId\");\r",
              "const expectedStatus = Number(pm.iterationData.get(\"expectedGetStatus\"));\r",
              "const expectedUserId = Number(pm.environment.get(\"userId\"));\r",
              "const expectedEmail = pm.iterationData.get(\"email\");\r",
              "const responseData = pm.response.json();\r",
              "\r",
              "pm.test(`[${tcId}] Get User status is ${expectedStatus}`, function () {\r",
              "    pm.response.to.have.status(expectedStatus);\r",
              "});\r",
              "\r",
              "pm.test(`[${tcId}] Profile ID and Email match CSV dataset`, function () {\r",
              "    pm.expect(responseData.data.id).to.eql(expectedUserId);\r",
              "    pm.expect(responseData.data.email).to.eql(expectedEmail);\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
